--- !u!114 &891403429
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 891403427}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05fbdcbb681bdeb4fb26b3678d019e2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  playTutorialOnStart: 0
  vrCamera: {fileID: 5278999426589827737}
  steps:
  - subtitleText: Aim your arm by holding the right hand trigger button. Release
      the trigger to extend arm.
    stepId: 
    displayDuration: 0
    completesObjective: 
  - subtitleText: Grab the Orb of Teleportation by holding the right hand select
      button.
    stepId: 
    displayDuration: 0
    completesObjective: 
  - subtitleText: Retract your arm with the orb in hand by pressing the trigger button.
    stepId: 
    displayDuration: 0
    completesObjective: 
  - subtitleText: Place the orb in the empty slot on your left hand.
    stepId: 
    displayDuration: 0
    completesObjective: 
  - subtitleText: You can now teleport by tilting the left thumbstick forward.
    stepId: 
    displayDuration: 4
    completesObjective: OrbObjective
  - subtitleText: Teleport to the next area through the door and look for the plate.
    stepId: TeleportStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Teleport on top of the pressure plate.
    stepId: LeverPlateStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Detatch the orb from your left hand and place it on the pedestal
      to start the 1st puzzle.
    stepId: OrbPedestalStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Grab and pull down the lever by shooting your arm on the surface
      of the wall and using the select button when your hand is on the handle..
    stepId: LeverStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: You have now completed the first objective.
    stepId: 
    displayDuration: 3
    completesObjective: 
  - subtitleText: Regrab the orb from the pedestal and teleport to the next room.
    stepId: RegrabOrbStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: When starting an objective you always have to teleport to the plate
      underneath the pedestal.
    stepId: FusePlateStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: When standing on the plate, you need to grab the orb off your left
      hand and place it on the pedestal to start the objective.
    stepId: FuseOrbStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: The fusebox needs 3 fuses to function. Grab the missing fuse and
      place it in the empty slot.
    stepId: FuseStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: You have now completed the tutorial, regrab the orb and go back
      through the door and into the main factory to complete the remaining objectives.
    stepId: 
    displayDuration: 8
    completesObjective: Tutorial
  maxPanelWidth: 1.2
  panelPadding: 5
  followDistance: 1.5
  viewOffsetX: 0
  viewOffsetY: -0.22
  followSmoothing: 0.3
  rotationSpeed: 5
  backgroundColor: {r: 0.2603773, g: 0.24394456, b: 0.22942679, a: 0.4745098}
