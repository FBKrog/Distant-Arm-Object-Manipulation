--- !u!114 &6557113022658846402
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 674290638065339267}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05fbdcbb681bdeb4fb26b3678d019e2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  playTutorialOnStart: 0
  vrCamera: {fileID: 0}
  steps:
  - subtitleText: You can use the <b>Go-Go interaction technique</b> to extend your
      arm to interact with distant objects.
    stepId: 
    displayDuration: 5
    completesObjective: 
  - subtitleText: To retrieve the blue orb on the table, you must stretch your hand
      outward and use the <b>[SELECT]</b> button to grab it.
    stepId: 
    displayDuration: 0
    completesObjective: 
  - subtitleText: Place the blue orb into the empty slot on your left hand to enable
      teleportation.
    stepId: 
    displayDuration: 0
    completesObjective: 
  - subtitleText: You must tilt the <b>[LEFT THUMBSTICK]</b> forward to teleport
      to a desired destination.
    stepId: TeleportStep
    displayDuration: 0
    completesObjective: OrbObjective
  - subtitleText: Teleport to the adjacent room and place the blue orb to the pedestal
      to begin the tutorial puzzle.
    stepId: HallwayStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: The fusebox needs three fuses to power on the light in the factory.
      Grab the missing fuse and place it in the empty slot in the fusebox, and pull
      the lever to turn on the light in the factory.
    stepId: FuseColliderStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Congratulations, you have now completed the tutorial! Please grab
      the orb and teleport further into the factory to complete the remaining tasks.
    stepId: 
    displayDuration: 6
    completesObjective: Tutorial
  maxPanelWidth: 0.8
  panelPadding: 3
  followDistance: 0.8
  viewOffsetX: 0
  viewOffsetY: -0.5
  followSmoothing: 0.35
  rotationSpeed: 6
  backgroundColor: {r: 0.16981131, g: 0.1612063, b: 0.15475257, a: 0.6509804}
  textColor: {r: 1, g: 0.7667351, b: 0.3150943, a: 1}
  fontSize: 3.5
  subtitleFont: {fileID: 0}
  objectivesManager: {fileID: 1034715964346803313}
