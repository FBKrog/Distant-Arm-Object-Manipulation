--- !u!114 &2207946992050787605
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1811118839066844378}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05fbdcbb681bdeb4fb26b3678d019e2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  playTutorialOnStart: 0
  vrCamera: {fileID: 0}
  steps:
  - subtitleText: You can use the <color=#FFFFFF>Go-Go interaction technique</color>
      to extend your arm to interact with distant objects.
    stepId: 
    displayDuration: 15
    completesObjective: 
  - subtitleText: To retrieve the <color=#87FFFF>blue orb</color> on the table, you
      must stretch your hand outward and use the <color=#FFFFFF>[SELECT]</color>
      button to grab it.
    stepId: GrabStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Bring the <color=#87FFFF>blue orb</color> back and place it into
      the empty slot on your left hand to enable teleportation.
    stepId: SnapStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: You can now tilt the <color=#FFFFFF>[LEFT THUMBSTICK]</color> forward
      to teleport to a desired destination.
    stepId: TeleportStep
    displayDuration: 0
    completesObjective: OrbObjective
  - subtitleText: 'Teleport to the orange rings on the floor in front of the pedestal
      on your right, in front of the computer.

      Place the <color=#87FFFF>blue
      orb</color> into the pedestal to begin the first tutorial task.'
    stepId: ComputerStart
    displayDuration: 0
    completesObjective: 
  - subtitleText: 'The computer will show a sequence on the buttons in yellow lights.

      Grab
      & Press the <color=#FFFFFF>buttons</color> on the computer in the correct sequence.'
    stepId: ComputerStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: 'Regrab the <color=#87FFFF>blue orb</color> and Teleport to the
      orange rings on the floor in front of the pedestal behind you.

      Place
      the <color=#87FFFF>blue orb</color> into the pedestal to begin the next tutorial
      task.'
    stepId: ValveStart
    displayDuration: 0
    completesObjective: 
  - subtitleText: Grab and turn the <color=#FFFFFF>Valve</color> on the wall.
    stepId: ValveStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: 'Regrab the <color=#87FFFF>blue orb</color> and teleport to the
      adjacent room through the 2 doors.

      The doors can open when the required
      tasks are completed and you stand in front of them.'
    stepId: HallwayStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Place the <color=#87FFFF>blue orb</color> into the pedestal to
      begin your next task.
    stepId: WireStart
    displayDuration: 0
    completesObjective: 
  - subtitleText: Grab the <color=#FFFFFF>Wire</color> and extend your <color=#FFFFFF>GoGo</color>
      Arm to place it into the Plug on the wall.
    stepId: WireStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Teleport to the next pedestal at the end of this room and place
      the <color=#87FFFF>blue orb</color> inside to begin your next task.
    stepId: FuseStart
    displayDuration: 0
    completesObjective: 
  - subtitleText: "The Fusebox needs <color=#FFFFFF>three fuses</color> to power
      on the light in the factory. \nGrab the missing fuse from the floor and place
      it into the Fusebox."
    stepId: FuseStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: 'On the wall there is a <color=#FFFFFF>Lever</color>.

      Grab
      and pull down the <color=#FFFFFF>Lever</color> to turn on the factory  lights.'
    stepId: LeverStep
    displayDuration: 0
    completesObjective: 
  - subtitleText: Congratulations, you have now completed the tutorial! Please grab
      the <color=#87FFFF>blue orb</color> and teleport further into the factory to
      complete the remaining tasks.
    stepId: 
    displayDuration: 13
    completesObjective: Tutorial
  maxPanelWidth: 0.8
  panelPadding: 3
  followDistance: 0.8
  viewOffsetX: 0
  viewOffsetY: -0.3
